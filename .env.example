# Node-RED
PORT=1880
NODE_RED_CREDENTIAL_SECRET=replace-with-a-long-random-string
AQUA_ALLOW_DEMO_AUTH=true
AQUA_ALLOW_LOCAL_AUTH=true
AQUA_LOCAL_SESSION_TTL_MS=2592000000
# Optional migration owner for the legacy esp32-aqua-01 identifier.
AQUA_DEVICE_OWNER_UID=
AQUA_LOCAL_DATA_PATH=
CLOUD_SAVE_INTERVAL_MS=60000
ALERT_COOLDOWN_MS=600000
DEVICE_OFFLINE_MS=45000

# Public MQTT broker used by Node-RED
MQTT_BROKER_HOST=broker.hivemq.com
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=nodered-hcmus-aqua-18

# Firebase Web App
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Firebase Admin SDK: use one of these options
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_USE_APPLICATION_DEFAULT=false
FIREBASE_CHECK_REVOKED_TOKENS=false

# Optional Firestore collection overrides
FIREBASE_TELEMETRY_COLLECTION=aquaTelemetry
FIREBASE_ALERTS_COLLECTION=aquaAlerts
FIREBASE_ACTIVITY_COLLECTION=aquaActivity
FIREBASE_PROFILES_COLLECTION=aquaProfiles
FIREBASE_DEVICES_COLLECTION=aquaDevices
FIREBASE_SYSTEM_COLLECTION=aquaSystem

# Telegram
TELEGRAM_BOT_TOKEN=
# Optional legacy recipient. New installs use the per-user link in the website.
TELEGRAM_CHAT_ID=
TELEGRAM_POLL_INTERVAL_MS=3000
TELEGRAM_LINK_TTL_MS=600000

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
# Leave empty for OpenAI. Set only for an OpenAI-compatible Responses API.
OPENAI_BASE_URL=
OPENAI_TIMEOUT_MS=25000
OPENAI_MAX_OUTPUT_TOKENS=500
CHAT_RATE_LIMIT_MAX=12
CHAT_RATE_LIMIT_WINDOW_MS=60000
