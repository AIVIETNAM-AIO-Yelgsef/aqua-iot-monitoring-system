  {
    "id": "a100000000000014",
    "type": "function",
    "z": "a100000000000001",
    "name": "Dinh dang online/offline",
    "func": "const online = String(msg.payload).toLowerCase() === 'online';\nmsg.payload = online ? 'ONLINE' : 'OFFLINE';\nconst svc = global.get('aquaServices');\nif (svc && typeof svc.setMqttStatus === 'function') {\n    try {\n        await Promise.resolve(svc.setMqttStatus(msg.payload));\n    } catch (error) {\n        node.error('Khong the cap nhat trang thai MQTT: ' + error.message, msg);\n    }\n}\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 390,
    "y": 300,
    "wires": [["a100000000000028"]]
  },
  {
    "id": "a100000000000015",
    "type": "function",
    "z": "a100000000000001",
    "name": "Tao lenh relay JSON",
    "func": "const turnOn = msg.payload === true || msg.payload === 1 || String(msg.payload).toUpperCase() === 'ON';\nmsg.topic = 'aqua-iot/nhom18-24127175-24127257/esp32-aqua-01/command';\nmsg.payload = JSON.stringify({\n    deviceId: 'esp32-aqua-01',\n    command: turnOn ? 'ON' : 'OFF',\n    mode: 'MANUAL',\n    requestId: 'web-' + Date.now()\n});\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 950,
    "y": 300,
    "wires": [["a100000000000016", "a100000000000018"]]
