  {
    "id": "a100000000000012",
    "type": "function",
    "z": "a100000000000001",
    "name": "Kiem tra va tach du lieu",
    "func": "let d = msg.payload;\nif (!d || typeof d !== 'object') {\n    node.warn('Payload aqua-iot/nhom18-24127175-24127257/esp32-aqua-01/data khong phai JSON object');\n    return null;\n}\n\nconst svc = global.get('aquaServices');\nif (svc && typeof svc.ingestTelemetry === 'function') {\n    try {\n        const normalized = await svc.ingestTelemetry(d);\n        if (normalized && typeof normalized === 'object') {\n            d = normalized;\n        }\n    } catch (error) {\n        node.error('Khong the luu/xu ly telemetry: ' + error.message, msg);\n    }\n}\n\nfunction numberOrNull(value) {\n    const n = Number(value);\n    return Number.isFinite(n) ? n : null;\n}\n\nconst now = Date.now();\nconst temperature = numberOrNull(d.temperature);\nconst turbidityVoltage = numberOrNull(d.turbidityVoltage);\nconst phVoltage = numberOrNull(d.phVoltage);\nconst turbidityRaw = numberOrNull(d.turbidityRaw);\nconst phRaw = numberOrNull(d.phRaw);\nconst relayOn = d.relayStatus === true || String(d.relayStatus).toUpperCase() === 'ON';\nconst updated = new Date(d.timestamp || d.recordedAt || now).toLocaleString('vi-VN');\nconst rssi = numberOrNull(d.rssi);\nconst deviceText = (d.deviceId || 'esp32-aqua-01') + (rssi === null ? '' : ' | WiFi ' + rssi + ' dBm');\n\nreturn [\n    temperature === null ? null : { payload: temperature, topic: 'Nhiet do', timestamp: now },\n    turbidityVoltage === null ? null : { payload: turbidityVoltage, topic: 'Do duc AO', timestamp: now },\n    phVoltage === null ? null : { payload: phVoltage, topic: 'pH Po', timestamp: now },\n    { payload: turbidityRaw === null ? '--' : Math.round(turbidityRaw) },\n    { payload: phRaw === null ? '--' : Math.round(phRaw) },\n    { payload: relayOn },\n    { payload: updated },\n    { payload: deviceText },\n    { payload: d }\n];",
    "outputs": 9,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 590,
    "y": 100,
    "wires": [
      ["a100000000000020", "a100000000000030"],
      ["a100000000000021", "a100000000000031"],
      ["a100000000000022", "a100000000000031"],
      ["a100000000000023"],
      ["a100000000000024"],
      ["a100000000000025"],
      ["a100000000000026"],
      ["a100000000000027"],
      ["a100000000000019"]
    ]
  },
